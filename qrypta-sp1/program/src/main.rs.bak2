#![no_main]
#![no_std]

extern crate alloc;

use alloc::vec::Vec;
use sp1_zkvm::{entrypoint, io};

entrypoint!(main);

pub fn main() {
    // Lee bytes desde el host (puedes cambiar el tipo luego)
    let input: Vec<u8> = io::read();

    // Tu lógica: por ahora lo dejamos como "echo"
    let result: Vec<u8> = input;

    // Commit de Vec<u8> (esto arregla el error del slice)
    io::commit(&result);
}
